(rule
 (alias runtest)
 (action (progn
  (run timeout 30 ./%{exe:signal_tests.exe} query-enter)
  (run timeout 30 ./%{exe:signal_tests.exe} query-leave)
  (run timeout 30 ./%{exe:signal_tests.exe} fetch-enter)
  (run timeout 30 ./%{exe:signal_tests.exe} fetch-leave)
  (run timeout 30 ./%{exe:signal_tests.exe} advance-enter)
  (run timeout 30 ./%{exe:signal_tests.exe} advance-leave)
  (run timeout 30 ./%{exe:signal_tests.exe} cleanup)
  (run timeout 30 ./%{exe:signal_tests.exe} cleanup-exn)
  (run timeout 30 ./%{exe:signal_tests.exe} callback))))
(rule
 (targets native_diagnostics.exe)
 (deps native_borrow.c native_borrow.h native_diagnostics.c)
 (action
  (run %{cc} -std=c11 -g -O1 -Wall -Wextra -Werror
   -fsanitize=address,undefined -fno-omit-frame-pointer
   -I%{env:DUCKDB_STAGE1_DIR=../.deps/duckdb}
   native_borrow.c native_diagnostics.c
   -L%{env:DUCKDB_STAGE1_DIR=../.deps/duckdb}
   -Wl,-rpath,%{env:DUCKDB_STAGE1_DIR=../.deps/duckdb}
   -lduckdb -o %{targets})))
