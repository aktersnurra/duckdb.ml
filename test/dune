(env (dev (flags (:standard -extension-universe beta))
          (c_flags (:standard -Werror)))
     (stage3a-sanitize
      (flags (:standard -extension-universe beta))
      (c_flags (:standard -Werror -g -O1 -fsanitize=address,undefined -fno-omit-frame-pointer))
      (link_flags (:standard -cclib -fsanitize=address,undefined))))
(test (name test_duckdb) (modules test_duckdb)
 (libraries base threads duckdb duckdb-ffi) (modes exe)
 (foreign_stubs (language c) (names test_hooks)
  (include_dirs %{env:DUCKDB_INCLUDE_DIR=../.deps/duckdb})
  (flags (:standard -std=c11 -Wall -Wextra)))
 (link_flags :standard -cclib -Wl,--wrap=duckdb_execute_prepared -cclib -Wl,--wrap=duckdb_disconnect
             -cclib -Wl,--wrap=duckdb_query -cclib -Wl,--wrap=duckdb_close
             -cclib -Wl,--wrap=caml_ml_condition_wait))
(test (name async_handoff) (modules async_handoff)
 (libraries duckdb async) (modes exe))
(test (name eio_handoff) (modules eio_handoff)
 (libraries base duckdb eio_main) (modes exe))
(executable (name test_signals) (modules test_signals)
 (libraries base duckdb duckdb-ffi)
 (foreign_stubs (language c) (names signal_stubs)
  (flags (:standard -std=c11 -Wall -Wextra)))
 (link_flags :standard -cclib -Wl,--wrap=caml_enter_blocking_section
             -cclib -Wl,--wrap=caml_leave_blocking_section))
(rule (alias runtest)
 (action (progn
  (run timeout 30 ./%{exe:test_signals.exe} open-enter)
  (run timeout 30 ./%{exe:test_signals.exe} open-leave)
  (run timeout 30 ./%{exe:test_signals.exe} connect-enter)
  (run timeout 30 ./%{exe:test_signals.exe} connect-leave)
  (run timeout 30 ./%{exe:test_signals.exe} query-enter)
  (run timeout 30 ./%{exe:test_signals.exe} query-leave)
  (run timeout 30 ./%{exe:test_signals.exe} database-close-enter)
  (run timeout 30 ./%{exe:test_signals.exe} database-close-leave)
  (run timeout 30 ./%{exe:test_signals.exe} connection-close-enter)
  (run timeout 30 ./%{exe:test_signals.exe} connection-close-leave)
  (run timeout 30 ./%{exe:test_signals.exe} transaction-enter)
  (run timeout 30 ./%{exe:test_signals.exe} transaction-leave)
  (run timeout 30 ./%{exe:test_signals.exe} transaction-callback)
  (run timeout 30 ./%{exe:test_signals.exe} transaction-rollback)
  (run timeout 30 ./%{exe:test_signals.exe} commit-enter)
  (run timeout 30 ./%{exe:test_signals.exe} commit-leave)
  (run timeout 30 ./%{exe:test_signals.exe} rollback-enter)
  (run timeout 30 ./%{exe:test_signals.exe} rollback-leave))))
(rule (alias runtest)
 (deps check_interfaces.sh ../lib/duckdb/duckdb.mli (glob_files compile/*))
 (action (run bash %{dep:check_interfaces.sh} %{ocamlc})))
