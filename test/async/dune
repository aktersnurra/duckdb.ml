(executable (name test_duckdb_async) (modules test_duckdb_async test_support test_native_cases test_instrumented_cases test_failure_cases)
 (libraries core async duckdb duckdb-async duckdb-ffi)
 (foreign_stubs (language c) (names async_hooks)
  (include_dirs %{env:DUCKDB_INCLUDE_DIR=../../.deps/duckdb})
  (flags (:standard -std=c11 -Wall -Wextra)))
 (link_flags :standard
  -cclib -Wl,--wrap=duckdb_open_ext
  -cclib -Wl,--wrap=duckdb_connect
  -cclib -Wl,--wrap=duckdb_disconnect
  -cclib -Wl,--wrap=caml_enter_blocking_section
  -cclib -Wl,--wrap=caml_leave_blocking_section
  -cclib -Wl,--wrap=duckdb_execute_prepared
  -cclib -Wl,--wrap=duckdb_query
  -cclib -Wl,--wrap=duckdb_destroy_result
  -cclib -Wl,--wrap=duckdb_destroy_prepare
  -cclib -Wl,--wrap=duckdb_destroy_extracted
  -cclib -Wl,--wrap=duckdb_destroy_data_chunk
  -cclib -Wl,--wrap=duckdb_close
  -cclib -Wl,--wrap=duckdb_appender_clear
  -cclib -Wl,--wrap=duckdb_appender_destroy
  -cclib -Wl,--wrap=duckdb_fetch_chunk
  -cclib -Wl,--wrap=duckdb_interrupt
  -cclib -Wl,--wrap=caml_thread_join
  -cclib -Wl,--wrap=ml_duckdb_native_request_deliver
  -cclib -Wl,--wrap=ml_duckdb_clear_work
  -cclib -Wl,--wrap=ml_duckdb_finish_result_close
  -cclib -Wl,--wrap=ml_duckdb_finish_prepared_close
  -cclib -Wl,--wrap=ml_duckdb_finish_appender_close
  -cclib -Wl,--wrap=ml_duckdb_finish_connection_close
  -cclib -Wl,--wrap=ml_duckdb_finish_database_close
  -cclib -Wl,--wrap=ml_duckdb_close_connection
  -cclib -Wl,--wrap=ml_duckdb_execute_control))
(rule (alias runtest) (action (run timeout 120 ./%{exe:test_duckdb_async.exe})))
(rule (alias runtest) (deps run_negative_controls.sh)
 (action (run bash %{dep:run_negative_controls.sh} ./%{exe:test_duckdb_async.exe})))
