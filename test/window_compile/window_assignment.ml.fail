module D = Duckdb
module S = D.Sql
let sales = D.Table.(declare "sales" Columns.["k", string; "d", int32; "v", int64; "n", nullable int64]
  ~row:(fun k d v n -> (k, d, v, n)))
let q = S.(command Params.[] (fun [] -> update sales (fun [_; d; v; _] ->
  set [v := row_number (window ~order_by:[asc d] ())])))
