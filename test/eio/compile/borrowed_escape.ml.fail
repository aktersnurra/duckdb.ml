let escape pool =
  Duckdb_eio.transaction pool ~f:(fun tx ->
    match Duckdb.prepare_transaction tx "SELECT 1" with
    | Error error -> Error error
    | Ok prepared ->
      match Duckdb.execute_prepared prepared with
      | Error error -> Error error
      | Ok result ->
        Duckdb.fold_chunks result ~init:None ~f:(fun chunk _ ->
          Ok (Duckdb.Stop (Some (fun () -> Duckdb.chunk_length chunk)))))
