(copy_files ../../../lib/eio/duckdb_eio.mli)
(copy_files ../../../lib/eio/worker_owner.mli)
(copy_files ../typed_probe.mli)
(copy_files ../parquet_cases.ml)
(copy_files ../parquet_cases.mli)
(copy_files ../parquet_hooks.ml)
(copy_files ../parquet_hooks.mli)
(copy_files ../parquet_hooks.c)
(rule (target adapter_source.ml) (deps ../../../lib/eio/duckdb_eio.ml) (action (copy %{deps} %{target})))
(rule (target owner_source.ml) (deps ../../../lib/eio/worker_owner.ml) (action (copy %{deps} %{target})))
(rule (target probe_source.ml) (deps ../typed_probe.ml) (action (copy %{deps} %{target})))
(rule (targets duckdb_eio.ml worker_owner.ml typed_probe.ml insertions.json)
 (deps generate.py adapter_source.ml owner_source.ml probe_source.ml)
 (action (run python3 %{dep:generate.py})))
(executable (name parquet_native) (modules parquet_native duckdb_eio worker_owner parquet_cases parquet_hooks typed_probe)
 (libraries base unix eio_main duckdb duckdb-ffi)
 (foreign_stubs (language c) (names parquet_hooks)
  (include_dirs %{env:DUCKDB_INCLUDE_DIR=../../../.deps/duckdb})
  (flags (:standard -std=c11 -Wall -Wextra -Werror)))
 (link_flags :standard
  -cclib -Wl,--wrap=duckdb_extract_statements
  -cclib -Wl,--wrap=duckdb_prepare_extracted_statement
  -cclib -Wl,--wrap=duckdb_execute_prepared
  -cclib -Wl,--wrap=duckdb_fetch_chunk
  -cclib -Wl,--wrap=duckdb_destroy_result
  -cclib -Wl,--wrap=duckdb_destroy_prepare
  -cclib -Wl,--wrap=duckdb_destroy_data_chunk
  -cclib -Wl,--wrap=duckdb_disconnect
  -cclib -Wl,--wrap=caml_enter_blocking_section
  -cclib -Wl,--wrap=caml_leave_blocking_section
  -cclib -Wl,--wrap=ml_duckdb_admit_local_file
  -cclib -Wl,--wrap=link
  -cclib -Wl,--wrap=unlink
  -cclib -Wl,--wrap=caml_sys_getcwd
))
(rule (alias runtest) (action (run timeout 90 ./%{exe:parquet_native.exe})))
