open! Base

module E = Duckdb_eio

let require name value = if not value then failwith name
let ok = function Ok value -> value | Error _ -> failwith "installed Eio failure"

let run () =
  require "adapter module initialization starts no scheduler" (Array.length (Stdlib.Sys.readdir "/proc/self/task") = 1);
  Eio_main.run (fun _env ->
    Eio.Switch.run (fun sw ->
      let pool = ok (E.create ~sw (ok (E.limits ~connections:1 ~queue_capacity:1))
        (ok (Duckdb.Config.create Duckdb.Config.Memory))) in
      Exn.protect
        ~finally:(fun () -> ok (E.shutdown pool))
        ~f:(fun () ->
          ok (E.execute pool "CREATE TABLE installed(i BIGINT)");
          let batches = [ [ [ Duckdb.Cell (Duckdb.Scalar.Required Duckdb.Scalar.Int64, 1L) ]
                            ; [ Duckdb.Cell (Duckdb.Scalar.Required Duckdb.Scalar.Int64, 2L) ] ] ] in
          ok (E.ingest pool ~schema:None ~table:"installed" ~batches ~flush:true);
          let rows = Duckdb.Row.(Column (Duckdb.Scalar.Required Duckdb.Scalar.Int64, Empty)) in
          require "installed typed query" (match E.query pool "SELECT i FROM installed ORDER BY i" rows with
            | Ok [1L, (); 2L, ()] -> true | _ -> false);
          let path = Stdlib.Filename.temp_file "duckdb_installed_eio" ".parquet" in
          Stdlib.Sys.remove path;
          Exn.protect
            ~finally:(fun () -> if Stdlib.Sys.file_exists path then Stdlib.Sys.remove path)
            ~f:(fun () ->
              ok (E.parquet_export pool ~query:"SELECT i FROM installed ORDER BY i" ~destination:path);
              require "installed Parquet fold" (match E.parquet_fold_rows pool [path] rows ~init:[]
                ~f:(fun row values -> Ok (Duckdb.Continue (row :: values))) with
                | Ok [2L, (); 1L, ()] -> true | _ -> false)))));
  Stdlib.print_endline "installed duckdb-eio typed operations and shutdown: passed"

let () = run ()
