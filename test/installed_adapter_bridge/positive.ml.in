open! Base
let ok = function Ok x -> x | Error _ -> failwith "installed Duckdb error"
let threads () = Array.length (Stdlib.Sys.readdir "/proc/self/task")
let () =
  (* This executable has no scheduler linked/started, and Fresh creates no
     controller. DuckDB engine worker threads exist only after open below. *)
  assert (threads () = 1);
  let request = Duckdb.Bridge.create () in
  assert (threads () = 1);
  let rows = ok (Duckdb.with_database (ok (Duckdb.Config.create Memory)) ~f:(fun db ->
    Duckdb.with_connection db ~f:(fun connection ->
      Duckdb.Bridge.run request connection ~f:(fun facade ->
        Duckdb.with_transaction facade ~f:(fun tx ->
          ok (Duckdb.execute_transaction tx "CREATE TABLE t(s VARCHAR)");
          ok (Duckdb.execute_transaction tx "INSERT INTO t VALUES ('installed-owned')");
          Duckdb.with_prepared_transaction tx "SELECT s FROM t" ~f:(fun prepared ->
            let result = ok (Duckdb.execute_prepared prepared) in
            Duckdb.fold_chunks result ~init:[] ~f:(fun chunk rows ->
              let text = ok (Duckdb.column chunk ~column:0 ~row:0 (Duckdb.Scalar.Required Duckdb.Scalar.String)) in
              Ok (Duckdb.Continue (text :: rows))))))))) in
  assert (List.equal String.equal rows ["installed-owned"]);
  assert (match Duckdb.Bridge.settlement request with Settled -> true | Pending -> false);
  assert (match Duckdb.Bridge.cancel request with Error Closed -> true | _ -> false);
  Stdlib.print_endline "installed Bridge: owned transaction, settled, late cancel Closed, no scheduler startup"
