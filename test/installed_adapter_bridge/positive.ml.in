open! Base
let ok = function Ok x -> x | Error _ -> failwith "installed Duckdb error"
let threads () = Array.length (Stdlib.Sys.readdir "/proc/self/task")
let () =
  (* This executable has no scheduler linked/started, and a canceller creates
     no controller. DuckDB engine worker threads exist only after open below. *)
  assert (threads () = 1);
  let canceller = Duckdb.Bridge.canceller () in
  assert (threads () = 1);
  let rows = ok (Duckdb.with_database (ok (Duckdb.Config.create Memory)) ~f:(fun db ->
    Duckdb.with_connection db ~f:(fun connection ->
      Duckdb.Bridge.run (Duckdb.Bridge.request canceller) connection ~f:(fun facade ->
        Duckdb.with_transaction facade ~f:(fun tx ->
          ok (Duckdb.execute tx "CREATE TABLE t(s VARCHAR)");
          ok (Duckdb.execute tx "INSERT INTO t VALUES ('installed-owned')");
          Duckdb.Statement.with_prepared tx "SELECT s FROM t" ~f:(fun prepared ->
            Duckdb.Statement.fold_chunks prepared ~init:[] ~f:(fun chunk rows ->
              let text = ok (Duckdb.Statement.column chunk ~column:0 ~row:0 (Duckdb.Codec.Values.string)) in
              Ok (Duckdb.Continue (text :: rows))))))))) in
  assert (List.equal String.equal rows ["installed-owned"]);
  assert (match Duckdb.Bridge.settlement canceller with Settled -> true | Pending -> false);
  Duckdb.Bridge.cancel canceller;
  assert (match Duckdb.Bridge.settlement canceller with Settled -> true | Pending -> false);
  Stdlib.print_endline "installed Bridge: owned transaction, settled, late cancel no-op, no scheduler startup"
