  -cclib -Wl,--wrap=duckdb_bind_int64
  -cclib -Wl,--wrap=duckdb_bind_double
  -cclib -Wl,--wrap=duckdb_bind_varchar_length
  -cclib -Wl,--wrap=duckdb_clear_bindings
  -cclib -Wl,--wrap=duckdb_create_timestamp_s
  -cclib -Wl,--wrap=duckdb_bind_value
  -cclib -Wl,--wrap=duckdb_destroy_value
  -cclib -Wl,--wrap=duckdb_fetch_chunk
  -cclib -Wl,--wrap=duckdb_destroy_data_chunk
  -cclib -Wl,--wrap=ml_duckdb_create_appender
  -cclib -Wl,--wrap=ml_duckdb_appender_nullable
  -cclib -Wl,--wrap=ml_duckdb_append_rows
  -cclib -Wl,--wrap=ml_duckdb_flush_appender
