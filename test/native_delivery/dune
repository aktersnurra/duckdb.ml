  -cclib -Wl,--wrap=ml_duckdb_execute -cclib -Wl,--wrap=ml_duckdb_native_request_create
  -cclib -Wl,--wrap=ml_duckdb_native_request_install -cclib -Wl,--wrap=ml_duckdb_native_request_uninstall
    -cclib -Wl,--wrap=ml_duckdb_prepare
  -cclib -Wl,--wrap=ml_duckdb_reset
  -cclib -Wl,--wrap=ml_duckdb_bind_null
  -cclib -Wl,--wrap=ml_duckdb_bind_int64
