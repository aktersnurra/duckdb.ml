(executable
 (name test_native_delivery)
 (modules test_native_delivery query_delivery appender_delivery control_publication)
 (libraries base threads duckdb duckdb-ffi evidence_support)
 (foreign_stubs (language c) (names delivery_hooks)
  (include_dirs %{env:DUCKDB_INCLUDE_DIR=../../.deps/duckdb})
  (flags (:standard -std=c11 -Wall -Wextra)))
 (link_flags :standard
  -cclib -Wl,--wrap=duckdb_extract_statements -cclib -Wl,--wrap=duckdb_prepare_extracted_statement
