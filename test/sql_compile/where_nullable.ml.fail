module D = Duckdb
module S = D.Sql
let users = D.Table.(declare "users" Columns.["id", int64; "name", string; "age", nullable int32]
  ~row:(fun id name age -> (id, name, age)))
let q = S.(query Params.[] (fun [] -> from users (fun [id; _; age] ->
  select Exprs.[id] ~row:(fun a -> a) ~where:Null.(age >= nullable (int32 18l)))))
