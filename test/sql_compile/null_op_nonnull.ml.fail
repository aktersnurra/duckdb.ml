module D = Duckdb
module S = D.Sql
let users = D.Table.(declare "users" Columns.["id", int64; "name", string; "age", nullable int32]
  ~row:(fun id name age -> (id, name, age)))
let q = S.(query Params.[] (fun [] -> from users (fun [id; _; _] ->
  select Exprs.[id] ~row:(fun a -> a) ~where:(is_true Null.(id > int64 1L)))))
