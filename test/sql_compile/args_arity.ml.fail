module D = Duckdb
module S = D.Sql
let users = D.Table.(declare "users" Columns.["id", int64; "name", string; "age", nullable int32]
  ~row:(fun id name age -> (id, name, age)))
let q = S.(query Params.[int64] (fun [p] -> from users (fun [id; _; _] ->
  select Exprs.[id] ~row:(fun i -> i) ~where:(id > param p))))
let run (c : D.connection) = D.Request.Session.collect c q D.Args.[1L; 2L]
