module D = Duckdb
module S = D.Sql
let users = D.Table.(declare "users" Columns.["id", int64; "name", string; "age", nullable int32]
  ~row:(fun id name age -> (id, name, age)))
let q = S.(query Params.[] (fun [] -> from users (fun [id; name; _] ->
  group_by Keys.[name] (fun [name] -> select Exprs.[name] ~row:(fun n -> n) ~having:(id > int64 1L)))))
