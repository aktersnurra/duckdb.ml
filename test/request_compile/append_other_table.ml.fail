module D = Duckdb
let t = D.Table.(declare "t" Columns.[ "value", int64; "note", string ] ~row:(fun v n -> (v, n)))
let u = D.Table.(declare "u" Columns.[ "flag", bool ] ~row:(fun b -> b))
let f c = D.Table.with_appender c t ~f:(fun a -> D.Table.with_appender c u ~f:(fun b ->
  ignore b; D.Table.append a [D.Args.[true]]))
