module D = Duckdb
let t = D.Table.(declare "t" Columns.[ "value", int64; "note", string ] ~row:(fun v n -> (v, n)))
let u = D.Table.(declare "u" Columns.[ "flag", bool ] ~row:(fun b -> b))
(* An appender of [u] given rows of [t]. Appenders are local to their scope,
   so a callback cannot hold one table's appender inside another's. *)
let f c = D.Table.with_appender c u ~f:(fun b -> D.Table.append b [D.Args.[1L; "x"]])
