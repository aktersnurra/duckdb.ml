opam-version: "2.0"
synopsis: "Safe synchronous DuckDB resources for pinned OxCaml"
description: "Reusable databases, connections, scoped cleanup and exclusive transactions. No scheduler startup or Async/Eio dependency. Stage 3a resource foundation only."
depends: [
  "oxcaml-compiler" {= "5.2.0minus39"}
  "dune" {= "3.22.2+ox"}
  "base" {= "v0.18~preview.130.106+341"}
  "duckdb-ffi" {= version}
]
build: [["dune" "build" "-p" name "-j" jobs]]
install: [["dune" "install" "--prefix" prefix name]]
